# Reference only. Prefer `sh scripts/setup.sh` (Docker) or `npm run setup` (Node).
# Setup generates all three secrets. Blank secrets below deliberately cannot boot.
# Required: admin dashboard access, at least 32 characters.
ADMIN_TOKEN=
# Required: 64 hex characters (32 bytes). Keep this key with database backups.
# Changing it makes existing encrypted settings and provider credentials unreadable.
ENCRYPTION_KEY=
# Required by Compose: initial PostgreSQL role password. Generated by setup.
# Editing this does NOT update the password in an existing database volume.
POSTGRES_PASSWORD=

# Optional for local evaluation; required to match your real origin for remote use.
# HTTP(S) origin only: no path, query, credentials, or fragment.
PUBLIC_URL=http://localhost:7001
# Optional host port binding for Compose; loopback is the default.
LANTERN_BIND_ADDRESS=127.0.0.1
# Pull-based compose.image.yaml only. Pin a version or digest for production.
# LANTERN_IMAGE=jctechmin/lantern:0.1.1
# Optional, only when using the bundled Caddy `https` profile.
# DOMAIN=lantern.example.com
# Optional fixed Compose project identity. Never change an existing installation's
# identity without explicitly migrating its named volumes.
# COMPOSE_PROJECT_NAME=lantern

# Direct Node only: Compose explicitly sets HOST, PORT and PostgreSQL connection.
# HOST=127.0.0.1
# PORT=7001
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=lantern
# PGUSER=lantern
# PGPASSWORD=
# Alternative to PG* for direct Node. Do not commit connection strings.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lantern
# Optional legacy SQLite import/detection path; never the active database.
# SQLITE_PATH=./data/lantern.sqlite
# DATA_DIR in older setup output is retained for compatibility; use SQLITE_PATH
# for a custom legacy database path. PostgreSQL owns active storage.
